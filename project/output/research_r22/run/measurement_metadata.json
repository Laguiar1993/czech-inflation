[
  {
    "variable": "core",
    "source": "CNB core",
    "units": "monthly log points",
    "transform": "100log1p(mm/100)"
  },
  {
    "variable": "services",
    "source": "CZSO R18 category proxy",
    "units": "mean monthly log points",
    "members": [
      "ict_services",
      "recreation_services",
      "cultural_services",
      "package_holidays",
      "catering",
      "accommodation"
    ],
    "limitation": "Not exhaustive CNB core component; equal statistical measurement weights."
  },
  {
    "variable": "housing",
    "source": "CZSO R18 category proxy",
    "units": "mean monthly log points",
    "members": [
      "actual_rent",
      "imputed_rent"
    ],
    "limitation": "Not exhaustive CNB core component; equal statistical measurement weights."
  },
  {
    "variable": "goods",
    "source": "CZSO R18 category proxy",
    "units": "mean monthly log points",
    "members": [
      "household_textiles",
      "tableware_utensils",
      "house_garden_tools",
      "vehicle_purchases",
      "ict_equipment",
      "recreation_durables",
      "other_recreation_goods",
      "garden_pets_goods",
      "musical_instruments_media",
      "books_stationery"
    ],
    "limitation": "Not exhaustive CNB core component; equal statistical measurement weights."
  },
  {
    "variable": "unemployment",
    "source": "eurostat:une_rt_m:SA:TOTAL:T:PC_ACT:CZ",
    "source_kind": "percent",
    "units": "percent level",
    "transform": "reported level",
    "availability": "existing per-observation available_from_assumed"
  },
  {
    "variable": "ip",
    "source": "czso:PRU01C:sa_calendar_adjusted_level",
    "source_kind": "index_level",
    "units": "log percentage points",
    "transform": "log change lag3",
    "availability": "existing per-observation available_from_assumed"
  },
  {
    "variable": "imports",
    "source": "czso:CEN0303:sitc_total:mm_pct",
    "source_kind": "mm_change_pct",
    "units": "log percentage points",
    "transform": "log1p monthly percent",
    "availability": "existing per-observation available_from_assumed"
  },
  {
    "variable": "ppi",
    "source": "eurostat:sts_inppd_m:PRC_PRR_DOM:C:I21:CZ",
    "source_kind": "index_level",
    "units": "log percentage points",
    "transform": "log change lag1",
    "availability": "existing per-observation available_from_assumed"
  },
  {
    "variable": "brent",
    "source": "bbg__brent_front_reference__month_mean",
    "source_kind": "level",
    "units": "log percentage points",
    "transform": "log change lag1",
    "availability": "existing per-observation available_from_assumed"
  },
  {
    "variable": "metals",
    "source": "bbg__industrial_metals_spot_index__month_mean",
    "source_kind": "level",
    "units": "log percentage points",
    "transform": "log change lag1",
    "availability": "existing per-observation available_from_assumed"
  },
  {
    "variable": "ulc",
    "source": "bbg__nominal_ulc_quarterly__as_reported",
    "units": "annual log growth of quarterly index; reference-step proxy",
    "limitation": "One quarterly observation carried from quarter-end through next two months, with identical source availability; no monthly observation claim."
  },
  {
    "variable": "fx",
    "source": "output/independent_path_frozen_inputs.csv:eurczk",
    "units": "monthly log points; positive=depreciation",
    "availability": "next-month day1"
  }
]